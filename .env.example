# Copy to .env and adjust. .env is in .gitignore: real credentials never go to Git.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quickserve

# Print every SQL statement the ORM sends. Turn on while learning, off in production
# (it is slow and can leak data into logs).
SQL_ECHO=false

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Order rules
RESTAURANT_ACCEPT_TIMEOUT_SECONDS=240
UNPAID_ORDER_TIMEOUT_SECONDS=600

# Bill (illustrative values)
PLATFORM_FEE=12.00
DELIVERY_FEE=30.00
FREE_DELIVERY_ABOVE=299.00
GST_RATE_FOOD=0.05
GST_RATE_FEES=0.18
